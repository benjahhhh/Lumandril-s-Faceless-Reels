# Copia este archivo a .env.local y rellena los valores.

# URL pública de la web (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: nunca en el navegador ni en el repositorio
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe → Developers → API keys (modo prueba: sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` te da este valor en local
STRIPE_WEBHOOK_SECRET=whsec_...
# Poner a true cuando Stripe Tax esté configurado (fase 5)
STRIPE_IMPUESTOS_AUTOMATICOS=false
